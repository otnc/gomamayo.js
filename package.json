{
  "name": "gomamayo",
  "version": "2.0.0",
  "description": "MeCab不要のゴママヨ検出ライブラリ",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "gomamayo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "dict"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "test": "jest",
    "format": "prettier --write ./src/ ./scripts/ ./test/ ./tsup.config.ts",
    "format:check": "prettier --check ./src/ ./scripts/ ./test/ ./tsup.config.ts",
    "build": "tsup",
    "build:dict": "node scripts/build-dict.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/gomamayo.js.git"
  },
  "keywords": [
    "gomamayo",
    "kuromoji",
    "sudachidict",
    "jp",
    "japan",
    "japanese"
  ],
  "author": "otoneko.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otnc/gomamayo.js/issues"
  },
  "homepage": "https://github.com/otnc/gomamayo.js#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^25.0.9",
    "@types/yargs": "^17.0.35",
    "adm-zip": "^0.5.16",
    "consola": "^3.4.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "kuromoji": "^0.1.2",
    "yargs": "^18.0.0"
  }
}
